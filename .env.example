# TheCookFlow Landing Page - Environment Variables

# Application URLs
VITE_APP_URL=https://app.thecookflow.com
VITE_ASSETS_URL=https://thecookflow.com

# Google Play Store URL (optional)
VITE_PLAY_URL=https://play.google.com/store/apps/details?id=com.thecookflow

# Formspree endpoint for newsletter
VITE_FORMSPREE_ID=your_formspree_id

# Google Analytics (optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Database (for backend, if used)
DATABASE_URL=postgresql://user:password@localhost:5432/thecookflow

# Session secret (for backend, if used)
SESSION_SECRET=your_secure_session_secret_here
